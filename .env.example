# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ComfyUI Configuration
# The URL where ComfyUI is running (same for portable and standard installations)
COMFYUI_BASE_URL=http://127.0.0.1:8188
# ComfyUI installation path (optional - only needed for file system operations)
# Portable: D:\ComfyUI_windows_portable
# Standard: C:\Users\YourName\ComfyUI
# Leave empty if not needed
COMFYUI_PATH=

# App Configuration
FLASK_PORT=5000
FLASK_DEBUG=True
