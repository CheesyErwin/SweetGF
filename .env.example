# ============================================
# TEXT GENERATION PROVIDER
# ============================================
# Choose your text generation provider: 'ollama', 'openai', or 'openrouter'
TEXT_PROVIDER=ollama

# ============================================
# OLLAMA CONFIGURATION (Local AI)
# ============================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q6_K
# GPU Configuration: 999 = auto-detect, 0 = CPU only, 1+ = use N GPUs
OLLAMA_NUM_GPU=999

# ============================================
# OPENAI CONFIGURATION (Cloud AI)
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Available models: gpt-4o-mini (recommended), gpt-4o, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini
# Base URL (for OpenAI-compatible APIs like Azure, LocalAI, LM Studio)
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================
# OPENROUTER CONFIGURATION (Multi-Model Access)
# ============================================
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Popular models:
#   anthropic/claude-3.5-sonnet (best quality)
#   openai/gpt-4o-mini (best value)
#   meta-llama/llama-3.1-8b-instruct:free (free)
#   sao10k/l3-euryale-70b (uncensored)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Optional: Your site URL and app name (for OpenRouter rankings)
OPENROUTER_SITE_URL=http://localhost:5000
OPENROUTER_APP_NAME=SweetGF

# ============================================
# COMFYUI CONFIGURATION (Image Generation)
# ============================================
# The URL where ComfyUI is running (same for portable and standard installations)
COMFYUI_BASE_URL=http://127.0.0.1:8188
# ComfyUI installation path (optional - only needed for file system operations)
# Portable: D:\ComfyUI_windows_portable
# Standard: C:\Users\YourName\ComfyUI
# Leave empty if not needed
COMFYUI_PATH=

# Image Generation Settings
IMAGE_GENERATION_TIMEOUT=600  # Timeout in seconds (default: 600 = 10 minutes)
IMAGE_GENERATION_STEPS=20  # Sampling steps (15-25, lower = faster, higher = better quality)
PRIME_COMFYUI_DEEP=false  # Pre-load checkpoint and LoRA at startup (adds 10-30s)

# Model Settings
COMFYUI_CHECKPOINT=waiNSFWIllustrious_v110.safetensors  # Main checkpoint model

# LoRA Settings
ENABLE_LORA=true  # Enable LoRA for anatomical detail enhancement (INTIMATE images only)
COMFYUI_LORA=Better_detailed_pussy_and_anus_v3.0.safetensors  # LoRA model file
COMFYUI_LORA_STRENGTH=0.7  # LoRA influence (0.5-1.0, higher = stronger effect)

# Enhancement Settings
ENABLE_FACE_DETAILER=true  # Enable face quality enhancement with secondary pass
FACEDETAILER_STEPS=20  # Face refinement steps (15-20)
FACEDETAILER_DENOISE=0.4  # Face refinement strength (0.3-0.5)
ENABLE_UPSCALE=true  # Enable 2x upscale (768x768 → 1536x1536)

# ============================================
# APP CONFIGURATION
# ============================================
FLASK_PORT=5000
FLASK_DEBUG=True
