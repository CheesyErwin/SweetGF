{
  "10": {
    "inputs": {
      "image": "{{image_source}}",
      "model": "{{model_source}}",
      "clip": "{{clip_source}}",
      "vae": ["4", 2],
      "guide_size": 512,
      "guide_size_for": true,
      "max_size": 1024,
      "seed": "{{seed}}",
      "steps": "{{facedetailer_steps}}",
      "cfg": 8.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "positive": ["6", 0],
      "negative": ["7", 0],
      "denoise": "{{facedetailer_denoise}}",
      "feather": 5,
      "noise_mask": true,
      "force_inpaint": true,
      "bbox_threshold": 0.5,
      "bbox_dilation": 10,
      "bbox_crop_factor": 3.0,
      "sam_detection_hint": "center-1",
      "sam_dilation": 0,
      "sam_threshold": 0.93,
      "sam_bbox_expansion": 0,
      "sam_mask_hint_threshold": 0.7,
      "sam_mask_hint_use_negative": "False",
      "drop_size": 10,
      "bbox_detector": ["12", 0],
      "wildcard": "",
      "cycle": 1
    },
    "class_type": "FaceDetailer"
  },
  "12": {
    "inputs": {
      "model_name": "bbox/face_yolov8n.pt"
    },
    "class_type": "UltralyticsDetectorProvider"
  }
